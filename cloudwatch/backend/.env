# ─── PostgreSQL ───────────────────────────────────────
DATABASE_URL=postgresql://cloudwatch:password@localhost:5432/cloudwatch

# ─── OpenStack ────────────────────────────────────────
OS_AUTH_URL=http://your-openstack:5000/v3
OS_USERNAME=admin
OS_PASSWORD=your-password
OS_PROJECT_NAME=admin
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default

# ─── OpenShift / Kubernetes ───────────────────────────
KUBE_API_URL=https://your-openshift-api:6443
KUBE_TOKEN=your-service-account-token
KUBE_VERIFY_SSL=false

# ─── Collecte ─────────────────────────────────────────
COLLECT_INTERVAL_SECONDS=30

# ─── Auth JWT ─────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Seuils d'alertes ─────────────────────────────────
ALERT_CPU_WARNING=70
ALERT_CPU_CRITICAL=90
ALERT_RAM_WARNING=75
ALERT_RAM_CRITICAL=90
-e 
# ─── Mode Mock (test sans OpenStack/OpenShift) ────────────────────────────────
# Mettre true pour tester avec des données simulées
MOCK_MODE=true

# Email notifications
EMAIL_ALERTS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
