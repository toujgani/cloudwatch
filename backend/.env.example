# ═══════════════════════════════════════════════════════════════════════════════
# Cloud AI Monitor — Environment Variables Template
# Copy to .env and fill in your values
# NEVER commit this file with real credentials
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cloudwatch:CHANGE_ME@localhost:5432/cloudwatch

# ── OpenStack ─────────────────────────────────────────────────────────────────
OS_AUTH_URL=
OS_USERNAME=
OS_PASSWORD=
OS_PROJECT_NAME=
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default

# ── OpenShift / Kubernetes ────────────────────────────────────────────────────
KUBE_API_URL=
KUBE_TOKEN=
KUBE_VERIFY_SSL=false
KUBE_NAMESPACE=

# ── Collector ─────────────────────────────────────────────────────────────────
COLLECT_INTERVAL_SECONDS=30

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_RANDOM_32_CHAR_MINIMUM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Alert Thresholds ─────────────────────────────────────────────────────────
ALERT_CPU_WARNING=70
ALERT_CPU_CRITICAL=90
ALERT_RAM_WARNING=75
ALERT_RAM_CRITICAL=90

# ── Email Notifications ──────────────────────────────────────────────────────
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
SMTP_USE_TLS=true

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_URL=
GRAFANA_API_TOKEN=
GRAFANA_METRICS_DATASOURCE_UID=
GRAFANA_LOGS_DATASOURCE_UID=
GRAFANA_TRACES_DATASOURCE_UID=
GRAFANA_VERIFY_SSL=true

# ── Financial Dashboard ──────────────────────────────────────────────────────
FINANCE_MONTHLY_INFRA_COST=10000
FINANCE_AUTOMATION_SAVINGS_RATE=0.12

# ── AI Remediation ───────────────────────────────────────────────────────────
AUTO_REMEDIATION_ENABLED=true
AUTO_REMEDIATION_DRY_RUN=true
AUTO_REMEDIATION_MIN_SCORE=55
REMEDIATION_STORAGE_INCREMENT_GB=20
REMEDIATION_MEMORY_SCALE_PERCENT=25
REMEDIATION_MAX_ACTIONS_PER_HOUR=5
REMEDIATION_MAX_STORAGE_GB=500
REMEDIATION_MEMORY_FLAVOR_MAP={}
REMEDIATION_VM_RECOVERY_ACTION=hard_reboot
REMEDIATION_K8S_SAFE_NAMESPACES=default

# ── Soft Quota ────────────────────────────────────────────────────────────────
SOFT_QUOTA_CPU_PERCENT=90
SOFT_QUOTA_RAM_PERCENT=90
QUOTA_THRESHOLD_WARNING=80
QUOTA_THRESHOLD_CRITICAL=90
QUOTA_THRESHOLD_REMEDIATE=95

# ── Seed Passwords (only used on first boot) ─────────────────────────────────
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_OPERATOR=
SEED_PASSWORD_VIEWER=

# ── Production ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=
