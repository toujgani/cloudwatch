# Cloud AI Monitor — OpenShift Secrets Template
# Copy to secrets.yaml and fill in real values before applying:
#   cp openshift/secrets.yaml.example openshift/secrets.yaml
#   oc apply -f openshift/secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: cloudwatch-secrets
  namespace: red1intheocean-dev
  labels:
    app.kubernetes.io/name: cloud-ai-monitor
    app.kubernetes.io/component: config
type: Opaque
stringData:
  DATABASE_URL: "postgresql://cloudwatch:YOUR_DB_PASSWORD@postgresql:5432/cloudwatch"
  SECRET_KEY: "YOUR_JWT_SECRET_MIN_32_CHARS"
  OS_PASSWORD: ""
  KUBE_TOKEN: ""
  GRAFANA_API_TOKEN: ""
  SMTP_PASSWORD: ""
---
apiVersion: v1
kind: Secret
metadata:
  name: postgresql-secret
  namespace: red1intheocean-dev
  labels:
    app.kubernetes.io/name: cloud-ai-monitor
    app.kubernetes.io/component: database
type: Opaque
stringData:
  POSTGRES_DB: "cloudwatch"
  POSTGRES_USER: "cloudwatch"
  POSTGRES_PASSWORD: "YOUR_DB_PASSWORD"
