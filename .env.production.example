# Cloud AI Monitor — Production Environment Variables
# Copy to .env.production and fill real values
# Deploy with: podman-compose --env-file .env.production up -d

# Database
DATABASE_URL=postgresql://cloudwatch:YOUR_DB_PASSWORD@postgres:5432/cloudwatch
POSTGRES_DB=cloudwatch
POSTGRES_USER=cloudwatch
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# OpenStack
OS_AUTH_URL=http://10.230.0.199:5000/v3
OS_USERNAME=unoc
OS_PASSWORD=YOUR_OPENSTACK_PASSWORD
OS_PROJECT_NAME=admin
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default

# OpenShift / Kubernetes
KUBE_API_URL=https://api.rm2.thpm.p1.openshiftapps.com:6443
KUBE_TOKEN=YOUR_SERVICE_ACCOUNT_TOKEN
KUBE_VERIFY_SSL=false
KUBE_NAMESPACE=red1intheocean-dev

# Collector
COLLECT_INTERVAL_SECONDS=30

# JWT
SECRET_KEY=YOUR_RANDOM_SECRET_KEY_MIN_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Email
EMAIL_ALERTS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD
SMTP_FROM=Cloud AI Monitor <your_email@gmail.com>
ALERT_EMAIL_TO=recipient1@email.com,recipient2@email.com
SMTP_USE_TLS=true

# Grafana
GRAFANA_URL=http://YOUR_GRAFANA_IP:3000
GRAFANA_API_TOKEN=YOUR_GRAFANA_TOKEN
GRAFANA_METRICS_DATASOURCE_UID=
GRAFANA_LOGS_DATASOURCE_UID=
GRAFANA_TRACES_DATASOURCE_UID=

# AI Remediation
AUTO_REMEDIATION_ENABLED=true
AUTO_REMEDIATION_DRY_RUN=false
AUTO_REMEDIATION_MIN_SCORE=40
REMEDIATION_MAX_ACTIONS_PER_HOUR=10
REMEDIATION_K8S_SAFE_NAMESPACES=red1intheocean-dev,default

# Soft Quota
SOFT_QUOTA_CPU_PERCENT=90
SOFT_QUOTA_RAM_PERCENT=90
QUOTA_THRESHOLD_WARNING=80
QUOTA_THRESHOLD_CRITICAL=90
QUOTA_THRESHOLD_REMEDIATE=95

# Production
LOG_LEVEL=INFO
CORS_ORIGINS=
