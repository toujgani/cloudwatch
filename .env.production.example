# ═══════════════════════════════════════════════════════════════════════════════
# Cloud AI Monitor — Production Environment Variables
# Used by: podman-compose up -d
# Copy to .env in the project root and fill with real values
# NEVER commit this file with real credentials to Git!
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=cloudwatch
POSTGRES_USER=cloudwatch
POSTGRES_PASSWORD=

# ── Application Security ──────────────────────────────────────────────────────
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── OpenStack Credentials ─────────────────────────────────────────────────────
OS_AUTH_URL=
OS_USERNAME=
OS_PASSWORD=
OS_PROJECT_NAME=
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default

# ── OpenShift / Kubernetes ────────────────────────────────────────────────────
KUBE_API_URL=
KUBE_TOKEN=
KUBE_VERIFY_SSL=false
KUBE_NAMESPACE=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_URL=
GRAFANA_API_TOKEN=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# ── AI Remediation ───────────────────────────────────────────────────────────
AUTO_REMEDIATION_ENABLED=true
AUTO_REMEDIATION_DRY_RUN=true
AUTO_REMEDIATION_MIN_SCORE=55

# ── Collector ─────────────────────────────────────────────────────────────────
COLLECT_INTERVAL_SECONDS=30

# ── Seed Passwords (used only on first boot) ─────────────────────────────────
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_OPERATOR=
SEED_PASSWORD_VIEWER=

# ── Production ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=
