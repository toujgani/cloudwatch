# ═══════════════════════════════════════════════════════════════════════════════
# Cloud AI Monitor — Production Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# Run: podman-compose up -d
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=cloudwatch
POSTGRES_USER=cloudwatch
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ─── Application Security ─────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_RANDOM_64_CHAR_STRING_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── OpenStack (provided by the company) ──────────────────────────────────────
OS_AUTH_URL=http://CONTROLLER_IP:5000/v3
OS_USERNAME=YOUR_USERNAME
OS_PASSWORD=YOUR_PASSWORD
OS_PROJECT_NAME=YOUR_PROJECT
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default

# ─── OpenShift / Kubernetes ───────────────────────────────────────────────────
KUBE_API_URL=https://OPENSHIFT_API_URL:6443
KUBE_TOKEN=YOUR_SERVICE_ACCOUNT_TOKEN
KUBE_VERIFY_SSL=false
KUBE_NAMESPACE=YOUR_NAMESPACE

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_URL=http://GRAFANA_IP:3000
GRAFANA_API_TOKEN=YOUR_GRAFANA_API_TOKEN
GRAFANA_METRICS_DATASOURCE_UID=
GRAFANA_LOGS_DATASOURCE_UID=
GRAFANA_TRACES_DATASOURCE_UID=

# ─── Email Notifications (SMTP) ──────────────────────────────────────────────
EMAIL_ALERTS_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@yourcompany.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=Cloud AI Monitor <alerts@yourcompany.com>
ALERT_EMAIL_TO=ops-team@yourcompany.com
SMTP_USE_TLS=true

# ─── Collector ────────────────────────────────────────────────────────────────
COLLECT_INTERVAL_SECONDS=30

# ─── Mock Mode (set to true ONLY for demos without real infrastructure) ───────
MOCK_OPENSTACK=false
MOCK_OPENSHIFT=false

# ─── AI Remediation ──────────────────────────────────────────────────────────
AUTO_REMEDIATION_ENABLED=true
AUTO_REMEDIATION_DRY_RUN=false
AUTO_REMEDIATION_MIN_SCORE=55
REMEDIATION_MAX_ACTIONS_PER_HOUR=5

# ─── Seed Passwords (only used on first boot when DB is empty) ────────────────
SEED_PASSWORD_ADMIN=CHANGE_ME_ADMIN_PASSWORD
SEED_PASSWORD_OPERATOR=CHANGE_ME_OPERATOR_PASSWORD
SEED_PASSWORD_VIEWER=CHANGE_ME_VIEWER_PASSWORD

# ─── Production ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=
